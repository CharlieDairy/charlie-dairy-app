# Local dev (SQLite):
# DATABASE_URL="file:./dev.db"

# Production (Postgres) — see docs/DEPLOYMENT.md
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-real-random-secret"

# Vercel Cron (nightly backup, daily Farm Watch): any random text of 16+ characters. Without it the cron routes refuse all calls.
CRON_SECRET="replace-with-16-or-more-random-characters"
# Token of a PRIVATE Vercel Blob store used only for backups (the photo store is public). See docs/DEPLOYMENT.md section 10.
BACKUP_BLOB_TOKEN=""
