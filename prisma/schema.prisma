generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENTRY
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  accessRoleId String?
  accessRole   AccessRole? @relation(fields: [accessRoleId], references: [id])
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  EXPORT
}

// A named, reusable bundle of granular (module, action) grants, assigned to
// non-ADMIN-role users in place of the old per-user coarse ModuleAccess
// list. ADMIN role always bypasses this entirely (see src/lib/access.ts) --
// this only governs ENTRY-role users. `module` is a nav section key (see
// src/lib/nav.ts NAV_SECTIONS) rather than its own enum, so the permission
// matrix and the sidebar/route-gating both stay driven by that one list.
model AccessRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AccessRolePermission[]
  users       User[]
}

model AccessRolePermission {
  id           String            @id @default(cuid())
  accessRoleId String
  accessRole   AccessRole        @relation(fields: [accessRoleId], references: [id], onDelete: Cascade)
  module       String
  action       PermissionAction

  @@unique([accessRoleId, module, action])
  @@index([accessRoleId])
}

enum CowGender {
  FEMALE
  MALE
  UNKNOWN
}

enum CowStatus {
  MILKING
  DRY
  HEIFER
  CALF
  INSEMINATED
  SOLD
  DEAD
}

model Cow {
  id                String   @id @default(cuid())
  tag               String   @unique
  breed             String?
  gender            CowGender @default(UNKNOWN)
  status            CowStatus @default(INSEMINATED)
  condition         String?
  dateOfBirth       DateTime?
  purchaseDate      DateTime?
  lastCalvingDate   DateTime?
  nextAiDate        DateTime?
  dryDate           DateTime?
  expectedCalving   DateTime?
  targetSellDate    DateTime?
  lactationNumber   Int      @default(0)
  notes             String?
  photoUrl          String?
  purchasePrice     Float?
  source            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  milkingRecords    MilkingRecord[]
  heatEvents        HeatEvent[]
  inseminations     Insemination[]
  pregnancyChecks   PregnancyCheck[]
  calvingsAsDam     Calving[]        @relation("DamCalvings")
  calfRecord        Calf?            @relation("CalfCow")
  weightRecords     WeightRecord[]
  movements         CowMovement[]
  customFieldValues CowCustomFieldValue[]
  vaccinations      VaccinationRecord[]
  treatments        TreatmentRecord[]
  productionTargets ProductionTarget[]
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
}

// Channab's "add custom fields to capture the data that matters to your
// farm — purchase price, source, insurance details, and more." Purchase
// price/source are real fixed Cow columns here already; this is the
// admin-defined, open-ended extension point for anything else a farm wants
// to track per animal without needing a schema change every time.
model CowCustomFieldDef {
  id        String          @id @default(cuid())
  label     String
  fieldType CustomFieldType @default(TEXT)
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())

  values    CowCustomFieldValue[]
}

model CowCustomFieldValue {
  id         String            @id @default(cuid())
  cowId      String
  cow        Cow               @relation(fields: [cowId], references: [id])
  fieldDefId String
  fieldDef   CowCustomFieldDef @relation(fields: [fieldDefId], references: [id])
  value      String
  updatedAt  DateTime          @updatedAt

  @@unique([cowId, fieldDefId])
  @@index([cowId])
  @@index([fieldDefId])
}

// Health module. VaccineDef/MedicineDef are small admin-managed catalogs
// (name + a default repeat interval so "next due" can be computed
// automatically) rather than free-text categories -- a vaccine's schedule is
// real structured data a farm relies on, not just a label.
model VaccineDef {
  id                 String   @id @default(cuid())
  name               String   @unique
  repeatIntervalDays Int?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  records            VaccinationRecord[]
}

model VaccinationRecord {
  id          String      @id @default(cuid())
  cowId       String
  cow         Cow         @relation(fields: [cowId], references: [id])
  vaccineDefId String?
  vaccineDef  VaccineDef? @relation(fields: [vaccineDefId], references: [id])
  vaccineName String
  date        DateTime
  nextDueDate DateTime?
  cost        Float?
  administeredBy String?
  notes       String?
  enteredBy   String?
  createdAt   DateTime    @default(now())

  @@index([cowId])
  @@index([date])
  @@index([nextDueDate])
}

model MedicineDef {
  id        String   @id @default(cuid())
  name      String   @unique
  unit      String?
  // Days milk must be withheld after treatment. Null = no withdrawal
  // configured for this medicine yet (deliberately not defaulted -- a wrong
  // guess at a regulatory withdrawal period is worse than none at all;
  // left for the admin to set per medicine).
  withdrawalDays Int?
  reorderLevel   Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  records          TreatmentRecord[]
  stockTransactions MedicineStockTransaction[]
}

model TreatmentRecord {
  id            String       @id @default(cuid())
  cowId         String
  cow           Cow          @relation(fields: [cowId], references: [id])
  medicineDefId String?
  medicineDef   MedicineDef? @relation(fields: [medicineDefId], references: [id])
  medicineName  String
  date          DateTime
  dosage        String?
  // Structured quantity consumed, separate from the free-text `dosage`
  // description -- this is what actually deducts MedicineStockTransaction
  // stock; `dosage` stays free text ("10ml, twice daily for 3 days") since
  // that's how vets/farmhands actually describe a regimen.
  quantityUsed  Float?
  // date + medicineDef.withdrawalDays at the time this was recorded, so
  // "who's currently in withdrawal" is a fast indexed range query instead
  // of a join + recompute against every medicine's current withdrawalDays.
  withdrawalUntil DateTime?
  reason        String?
  cost          Float?
  administeredBy String?
  notes         String?
  enteredBy     String?
  createdAt     DateTime     @default(now())

  @@index([cowId])
  @@index([date])
  @@index([withdrawalUntil])
}

enum MedicineStockDirection {
  IN
  OUT
}

// Mirrors FeedTransaction's IN/OUT ledger pattern, keyed by a real FK
// (MedicineDef already has one, unlike Feed's free-text match) since every
// treatment is already linked to a catalog medicine. OUT rows are created
// automatically by recordTreatment when a quantityUsed is entered; IN rows
// come from the Restock Medicine form.
model MedicineStockTransaction {
  id            String                 @id @default(cuid())
  medicineDefId String
  medicineDef   MedicineDef            @relation(fields: [medicineDefId], references: [id])
  date          DateTime
  direction     MedicineStockDirection
  quantity      Float
  cost          Float?
  notes         String?
  enteredBy     String?
  createdAt     DateTime               @default(now())

  @@index([medicineDefId])
  @@index([date])
}

// Scoring module (Channab-style): a configurable weighted health score per
// animal, computed live from real vaccination/treatment data rather than
// stored -- there's nothing to keep in sync, and it's always accurate.
// ScoringFactor rows are the "Scoring Setup" weights; UI enforces they sum
// to 100 before saving, so scoring.ts can trust that invariant when reading.
enum ScoringFactorKey {
  VACCINATION_COMPLIANCE
  TREATMENT_FREQUENCY
  HEALTH_RECENCY
}

model ScoringFactor {
  id        String           @id @default(cuid())
  key       ScoringFactorKey @unique
  label     String
  weightPct Int
  updatedAt DateTime         @updatedAt
}

enum HealthScheduleType {
  VACCINATION
  DEWORMING
  CHECKUP
}

// A recurring rule ("Deworm every 90 days"), not a per-animal occurrence --
// due/overdue status is derived by matching the most recent Vaccination/
// TreatmentRecord whose name matches this schedule's name against its
// interval, the same live-computed approach as the scoring engine.
model HealthSchedule {
  id           String             @id @default(cuid())
  name         String
  type         HealthScheduleType
  intervalDays Int
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

enum ProductionTargetType {
  MILK_DAILY
  WEIGHT
}

model ProductionTarget {
  id          String               @id @default(cuid())
  cowId       String
  cow         Cow                  @relation(fields: [cowId], references: [id], onDelete: Cascade)
  type        ProductionTargetType
  targetValue Float
  targetDate  DateTime?
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([cowId])
}

// Herd Management: per-animal weight over time, shown as a trend on the cow
// profile (mirrors Channab's weight dashboard / growth target monitoring).
model WeightRecord {
  id        String   @id @default(cuid())
  cowId     String
  cow       Cow      @relation(fields: [cowId], references: [id])
  date      DateTime
  weightKg  Float
  enteredBy String?
  createdAt DateTime @default(now())

  @@index([cowId])
  @@index([date])
}

// Target weight range at a given age checkpoint, optionally specific to a
// breed (null = applies to any breed). Lets the Weight Dashboard flag an
// animal as under/on/over target for its age instead of just showing a
// number with no reference point -- Channab's "Weight Standards".
model WeightStandard {
  id          String   @id @default(cuid())
  breed       String?
  ageMonths   Int
  minWeightKg Float
  maxWeightKg Float
  createdAt   DateTime @default(now())

  @@unique([breed, ageMonths])
  @@index([ageMonths])
}

// Herd Management: location/movement history per animal (e.g. between sheds
// or a treatment area), mirroring Channab's movement tracking.
model CowMovement {
  id        String   @id @default(cuid())
  cowId     String
  cow       Cow      @relation(fields: [cowId], references: [id])
  date      DateTime
  location  String
  notes     String?
  enteredBy String?
  createdAt DateTime @default(now())

  @@index([cowId])
  @@index([date])
}

enum HeatDetectionMethod {
  VISUAL
  ACTIVITY_MONITOR
  TAIL_PAINT
  OTHER
}

model HeatEvent {
  id              String   @id @default(cuid())
  cowId           String
  cow             Cow      @relation(fields: [cowId], references: [id])
  detectedAt      DateTime
  detectionMethod HeatDetectionMethod @default(VISUAL)
  intensity       String?
  notes           String?
  enteredBy       String?
  createdAt       DateTime @default(now())

  insemination    Insemination?

  @@index([cowId])
  @@index([detectedAt])
}

enum BreedingMethod {
  AI
  NATURAL
  EMBRYO_TRANSFER
}

model Insemination {
  id            String   @id @default(cuid())
  cowId         String
  cow           Cow      @relation(fields: [cowId], references: [id])
  heatEventId   String?  @unique
  heatEvent     HeatEvent? @relation(fields: [heatEventId], references: [id])
  date          DateTime
  method        BreedingMethod @default(AI)
  semenBatch    String?
  bullTag       String?
  technician    String?
  serviceNumber Int      @default(1)
  cost          Float?
  notes         String?
  enteredBy     String?
  createdAt     DateTime @default(now())

  pregnancyChecks PregnancyCheck[]
  calvings        Calving[]

  @@index([cowId])
  @@index([date])
}

enum PregnancyResult {
  PREGNANT
  OPEN
  INCONCLUSIVE
}

enum PregnancyCheckMethod {
  PALPATION
  ULTRASOUND
  BLOOD_TEST
  OBSERVATION
}

model PregnancyCheck {
  id             String   @id @default(cuid())
  cowId          String
  cow            Cow      @relation(fields: [cowId], references: [id])
  inseminationId String?
  insemination   Insemination? @relation(fields: [inseminationId], references: [id])
  date           DateTime
  method         PregnancyCheckMethod @default(PALPATION)
  result         PregnancyResult
  notes          String?
  performedBy    String?
  createdAt      DateTime @default(now())

  @@index([cowId])
  @@index([date])
}

enum CalvingDifficulty {
  UNASSISTED
  EASY_PULL
  HARD_PULL
  VET_ASSISTED
  CAESAREAN
}

enum CalfOutcome {
  ALIVE
  STILLBORN
  DIED_WITHIN_24H
}

model Calving {
  id               String   @id @default(cuid())
  damId            String
  dam              Cow      @relation("DamCalvings", fields: [damId], references: [id])
  inseminationId   String?
  insemination     Insemination? @relation(fields: [inseminationId], references: [id])
  sireTag          String?
  date             DateTime
  gestationDays    Int?
  difficulty       CalvingDifficulty @default(UNASSISTED)
  assistedBy       String?
  retainedPlacenta Boolean  @default(false)
  complications    String?
  calfCount        Int      @default(1)
  notes            String?
  enteredBy        String?
  createdAt        DateTime @default(now())

  calves           Calf[]

  @@index([damId])
  @@index([date])
}

model Calf {
  id          String   @id @default(cuid())
  calvingId   String
  calving     Calving  @relation(fields: [calvingId], references: [id])
  cowId       String?  @unique
  cow         Cow?     @relation("CalfCow", fields: [cowId], references: [id])
  sex         CowGender @default(UNKNOWN)
  outcome     CalfOutcome @default(ALIVE)
  birthWeight Float?
  tag         String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([calvingId])
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
}

model MilkingRecord {
  id        String   @id @default(cuid())
  cowId     String?
  cow       Cow?     @relation(fields: [cowId], references: [id])
  date      DateTime
  shift     Shift
  litres    Float
  fatPct    Float?
  snfPct    Float?
  enteredBy String?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([cowId])
}

enum MilkUsageType {
  FARM_USE
  EMPLOYEE_USE
  CALF_USE
}

// Daily production isn't all sellable -- some is consumed by calves, given
// to farm employees, or used elsewhere on the farm (household etc.).
// Recording that explicitly, instead of letting it disappear into the
// unexplained "produced minus sold" variance on Production Reconciliation,
// is what makes that gap a real reconciled number:
// Produced - CalfUse - FarmUse - EmployeeUse - Sold should trend to zero.
// Valued at the farm's average sale rate for a notional (non-cash) cost
// line -- no CashTransaction is created since no money actually moves.
model MilkUsageRecord {
  id        String        @id @default(cuid())
  date      DateTime
  type      MilkUsageType
  litres    Float
  notes     String?
  enteredBy String?
  createdAt DateTime      @default(now())

  @@index([date])
}

model MilkSale {
  id        String   @id @default(cuid())
  date      DateTime
  buyer     String
  shift     Shift?
  litres    Float
  rate      Float?
  fatPct    Float?
  snf       Float?
  amount    Float
  enteredBy String?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([buyer])
}

// A milk customer's payment. Always creates a linked CashTransaction in the
// same action (see src/app/admin/reports/milk-sales/actions.ts) so this
// money shows up in the real cash ledger / P&L -- never a parallel,
// untracked balance. "buyer" matches MilkSale.buyer (same free-text-key
// pattern already used across the app, e.g. Master Data categories).
model CustomerPayment {
  id                String           @id @default(cuid())
  buyer             String
  date              DateTime
  amount            Float
  mode              CashMode         @default(CASH)
  notes             String?
  cashTransactionId String?          @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id])
  enteredBy         String?
  createdAt         DateTime         @default(now())

  @@index([buyer])
  @@index([date])
}

// Team/HR module. Users & Access already covers app logins/permissions --
// this is the separate, real concern of actual farm staff (who may or may
// not have an app login at all), their pay, and their attendance.
model Employee {
  id            String   @id @default(cuid())
  name          String
  position      String?
  phone         String?
  monthlySalary Float?
  joinDate      DateTime?
  active        Boolean  @default(true)
  notes         String?
  photoUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  salaryPayments    SalaryPayment[]
  attendanceRecords AttendanceRecord[]
}

// Always creates a linked CashTransaction in the same action (matching
// CustomerPayment's pattern above) so a salary payment is never a parallel,
// untracked number -- it shows up in Cash Flow/P&L immediately, filed under
// the same "Opex Salaries" category this farm's real historical cash ledger
// already uses.
model SalaryPayment {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id])
  date              DateTime
  amount            Float
  forMonth          String?
  mode              CashMode         @default(CASH)
  notes             String?
  cashTransactionId String?          @unique
  cashTransaction   CashTransaction? @relation(fields: [cashTransactionId], references: [id])
  enteredBy         String?
  createdAt         DateTime         @default(now())

  @@index([employeeId])
  @@index([date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  enteredBy  String?
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

enum FeedDirection {
  IN
  OUT
}

model FeedTransaction {
  id        String        @id @default(cuid())
  date      DateTime
  feedType  String
  direction FeedDirection
  quantity  Float
  rate      Float?
  cost      Float?
  notes     String?
  enteredBy String?
  createdAt DateTime      @default(now())

  @@index([date])
  @@index([feedType])
}

// Feed Master: the catalog of feed types (Silage, Wenda, Turi, Fodder, etc.)
// used by Feed Entry and Feed Overview. Replaces the earlier separate
// "general Inventory" module -- that module's stock ledger (InventoryTransaction)
// duplicated what FeedTransaction already tracked and was dropped; this model
// is the renamed survivor of its catalog half (InventoryItem), now scoped to
// feed specifically. FeedTransaction.feedType stays free-text and is matched
// against FeedItem.name for unit/category/reorder-level lookups, the same
// string-match pattern already used for MasterDataItem labels.
model FeedItem {
  id           String   @id @default(cuid())
  name         String   @unique
  unit         String
  category     String?
  reorderLevel Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

// Milk customer master: real contact/commercial terms for a buyer, matched
// against MilkSale.buyer by name (same free-text-key pattern as FeedItem/
// MasterDataItem) so existing MilkSale history stays intact -- this doesn't
// require re-keying any sales record.
model Customer {
  id            String   @id @default(cuid())
  name          String   @unique
  phone         String?
  address       String?
  paymentTerms  String?
  agreedRate    Float?
  active        Boolean  @default(true)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Matched by name (case-insensitive) against CashTransaction.party, the
// same free-text-key convention Customer uses against MilkSale.buyer -- no
// FK, so existing cash rows link up the moment a vendor with that name
// exists, and nothing needs backfilling.
model Vendor {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String?
  address   String?
  category  String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CashMode {
  CASH
  BANK
}

model CashTransaction {
  id          String   @id @default(cuid())
  date        DateTime
  time        String?
  account     String?
  party       String?
  category    String
  mode        CashMode @default(CASH)
  amountIn    Float    @default(0)
  amountOut   Float    @default(0)
  enteredBy   String?
  projectLand String?
  remark      String?
  createdAt   DateTime @default(now())

  customerPayment CustomerPayment?
  salaryPayment   SalaryPayment?

  @@index([date])
  @@index([category])
}

enum CapitalEntryType {
  CONTRIBUTION
  WITHDRAWAL
  LOAN
  REPAYMENT
  OTHER
}

model CapitalEntry {
  id          String           @id @default(cuid())
  date        DateTime
  partner     String
  description String
  debit       Float            @default(0)
  credit      Float            @default(0)
  bankAccount String?
  type        CapitalEntryType @default(OTHER)
  venture     String?
  createdAt   DateTime         @default(now())

  @@index([date])
  @@index([partner])
}

model MasterDataItem {
  id        String   @id @default(cuid())
  category  String
  code      String
  label     String
  active    Boolean  @default(true)
  locked    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, code])
  @@index([category])
}

model Asset {
  id              String    @id @default(cuid())
  assetClass      String
  details         String
  qty             Float
  value           Float
  depreciationPct Float     @default(0)
  yearLived       Int       @default(0)
  currentValue    Float
  valuationDate   DateTime?
  photoUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}
