generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ENTRY
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
}

enum CowGender {
  FEMALE
  MALE
  UNKNOWN
}

enum CowStatus {
  MILKING
  DRY
  HEIFER
  CALF
  DORMANT
  SOLD
  DEAD
}

model Cow {
  id                String   @id @default(cuid())
  tag               String   @unique
  gender            CowGender @default(UNKNOWN)
  status            CowStatus @default(DORMANT)
  condition         String?
  dateOfBirth       DateTime?
  lastCalvingDate   DateTime?
  nextAiDate        DateTime?
  dryDate           DateTime?
  expectedCalving   DateTime?
  targetSellDate    DateTime?
  lactationNumber   Int      @default(0)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  milkingRecords    MilkingRecord[]
  heatEvents        HeatEvent[]
  inseminations     Insemination[]
  pregnancyChecks   PregnancyCheck[]
  calvingsAsDam     Calving[]        @relation("DamCalvings")
  calfRecord        Calf?            @relation("CalfCow")
}

enum HeatDetectionMethod {
  VISUAL
  ACTIVITY_MONITOR
  TAIL_PAINT
  OTHER
}

model HeatEvent {
  id              String   @id @default(cuid())
  cowId           String
  cow             Cow      @relation(fields: [cowId], references: [id])
  detectedAt      DateTime
  detectionMethod HeatDetectionMethod @default(VISUAL)
  intensity       String?
  notes           String?
  enteredBy       String?
  createdAt       DateTime @default(now())

  insemination    Insemination?

  @@index([cowId])
  @@index([detectedAt])
}

enum BreedingMethod {
  AI
  NATURAL
  EMBRYO_TRANSFER
}

model Insemination {
  id            String   @id @default(cuid())
  cowId         String
  cow           Cow      @relation(fields: [cowId], references: [id])
  heatEventId   String?  @unique
  heatEvent     HeatEvent? @relation(fields: [heatEventId], references: [id])
  date          DateTime
  method        BreedingMethod @default(AI)
  semenBatch    String?
  bullTag       String?
  technician    String?
  serviceNumber Int      @default(1)
  cost          Float?
  notes         String?
  enteredBy     String?
  createdAt     DateTime @default(now())

  pregnancyChecks PregnancyCheck[]
  calvings        Calving[]

  @@index([cowId])
  @@index([date])
}

enum PregnancyResult {
  PREGNANT
  OPEN
  INCONCLUSIVE
}

enum PregnancyCheckMethod {
  PALPATION
  ULTRASOUND
  BLOOD_TEST
  OBSERVATION
}

model PregnancyCheck {
  id             String   @id @default(cuid())
  cowId          String
  cow            Cow      @relation(fields: [cowId], references: [id])
  inseminationId String?
  insemination   Insemination? @relation(fields: [inseminationId], references: [id])
  date           DateTime
  method         PregnancyCheckMethod @default(PALPATION)
  result         PregnancyResult
  notes          String?
  performedBy    String?
  createdAt      DateTime @default(now())

  @@index([cowId])
  @@index([date])
}

enum CalvingDifficulty {
  UNASSISTED
  EASY_PULL
  HARD_PULL
  VET_ASSISTED
  CAESAREAN
}

enum CalfOutcome {
  ALIVE
  STILLBORN
  DIED_WITHIN_24H
}

model Calving {
  id               String   @id @default(cuid())
  damId            String
  dam              Cow      @relation("DamCalvings", fields: [damId], references: [id])
  inseminationId   String?
  insemination     Insemination? @relation(fields: [inseminationId], references: [id])
  sireTag          String?
  date             DateTime
  gestationDays    Int?
  difficulty       CalvingDifficulty @default(UNASSISTED)
  assistedBy       String?
  retainedPlacenta Boolean  @default(false)
  complications    String?
  calfCount        Int      @default(1)
  notes            String?
  enteredBy        String?
  createdAt        DateTime @default(now())

  calves           Calf[]

  @@index([damId])
  @@index([date])
}

model Calf {
  id          String   @id @default(cuid())
  calvingId   String
  calving     Calving  @relation(fields: [calvingId], references: [id])
  cowId       String?  @unique
  cow         Cow?     @relation("CalfCow", fields: [cowId], references: [id])
  sex         CowGender @default(UNKNOWN)
  outcome     CalfOutcome @default(ALIVE)
  birthWeight Float?
  tag         String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([calvingId])
}

enum Shift {
  MORNING
  AFTERNOON
  EVENING
}

model MilkingRecord {
  id        String   @id @default(cuid())
  cowId     String?
  cow       Cow?     @relation(fields: [cowId], references: [id])
  date      DateTime
  shift     Shift
  litres    Float
  enteredBy String?
  createdAt DateTime @default(now())

  @@index([date])
  @@index([cowId])
}

model MilkSale {
  id        String   @id @default(cuid())
  date      DateTime
  buyer     String
  litres    Float
  rate      Float?
  fatPct    Float?
  snf       Float?
  amount    Float
  enteredBy String?
  createdAt DateTime @default(now())

  @@index([date])
}

enum FeedDirection {
  IN
  OUT
}

model FeedTransaction {
  id        String        @id @default(cuid())
  date      DateTime
  feedType  String
  direction FeedDirection
  quantity  Float
  rate      Float?
  cost      Float?
  notes     String?
  enteredBy String?
  createdAt DateTime      @default(now())

  @@index([date])
  @@index([feedType])
}

enum CashMode {
  CASH
  BANK
}

model CashTransaction {
  id          String   @id @default(cuid())
  date        DateTime
  time        String?
  account     String?
  party       String?
  category    String
  mode        CashMode @default(CASH)
  amountIn    Float    @default(0)
  amountOut   Float    @default(0)
  enteredBy   String?
  projectLand String?
  remark      String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([category])
}

enum CapitalEntryType {
  CONTRIBUTION
  WITHDRAWAL
  LOAN
  REPAYMENT
  OTHER
}

model CapitalEntry {
  id          String           @id @default(cuid())
  date        DateTime
  partner     String
  description String
  debit       Float            @default(0)
  credit      Float            @default(0)
  bankAccount String?
  type        CapitalEntryType @default(OTHER)
  venture     String?
  createdAt   DateTime         @default(now())

  @@index([date])
  @@index([partner])
}

model MasterDataItem {
  id        String   @id @default(cuid())
  category  String
  code      String
  label     String
  active    Boolean  @default(true)
  locked    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, code])
  @@index([category])
}

model Asset {
  id              String    @id @default(cuid())
  assetClass      String
  details         String
  qty             Float
  value           Float
  depreciationPct Float     @default(0)
  yearLived       Int       @default(0)
  currentValue    Float
  valuationDate   DateTime?
  photoUrl        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([userId])
  @@index([createdAt])
}
